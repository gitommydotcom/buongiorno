# Basic auth gate (mantiene il sito privato)
APP_PASSWORD=cambiami

# Saluto personalizzato
USER_NAME=Tommaso

# Apple iCloud (CalDAV) — password app-specific da appleid.apple.com
ICLOUD_USERNAME=tuo@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GOOGLE_REFRESH_TOKEN=

# Groq (AI gratuita)
GROQ_API_KEY=

# TomTom (traffico, free 2500/giorno)
TOMTOM_API_KEY=

# Default location/lingua iniziali (poi modificabili da /impostazioni)
DEFAULT_LAT=42.3498
DEFAULT_LON=13.3995
DEFAULT_PLACE_NAME=L'Aquila
DEFAULT_LANGUAGE=it
